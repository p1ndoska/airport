generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model News {
  id        Int      @id @default(autoincrement())
  name      String
  content   String?
  photo     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
